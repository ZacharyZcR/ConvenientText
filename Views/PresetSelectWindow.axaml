<!--
  ============================================================
  PresetSelectWindow.axaml
  作用："选择预设文本"弹窗界面。
  展示全局预设库中的所有预设文本（按分类分组），
  用户点击某条预设后，文本通过 SelectedPresetText 属性返回。
  
  窗口特性：
    - 亚克力模糊无边框窗口
    - 自定义标题栏（拖动 + 关闭）
    - 按分类分组显示的预设列表
    - 底部取消按钮
  ============================================================
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ConvenientText.Views.PresetSelectWindow"
        Title="选择预设"
        Width="420"
        Height="400"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Topmost="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent">
	<!-- 外层圆角边框：磨砂玻璃背景 -->
	<Border CornerRadius="12"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            Padding="16,10,16,16">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!-- 自定义标题栏 -->
			<Grid x:Name="TitleBar" Grid.Row="0" Margin="0,0,0,12">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<TextBlock Text="选择预设文本"
                           FontWeight="SemiBold"
                           FontSize="14"
                           VerticalAlignment="Center" />
				<Button x:Name="TitleBarCloseButton"
                        Grid.Column="1"
                        Content="✕"
                        FontSize="13"
                        Width="30"
                        Height="30"
                        Padding="0"
                        CornerRadius="4"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#CCFFFFFF">
					<Button.Styles>
						<Style Selector="Button:pointerover">
							<Setter Property="Background" Value="#E81123" />
							<Setter Property="Foreground" Value="White" />
						</Style>
					</Button.Styles>
				</Button>
			</Grid>

			<!-- 预设列表：按分类分组 -->
			<ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
				<StackPanel x:Name="PresetGroupPanel" Spacing="2" />
			</ScrollViewer>

			<!-- 底部按钮栏 -->
			<StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0"
                        Spacing="10">
				<Button Content="取消"
                        Width="80"
                        Click="OnCancelClick" />
			</StackPanel>
		</Grid>
	</Border>
</Window>
